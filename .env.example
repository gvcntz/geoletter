# Copy to .env (never commit it). Generate secrets with: openssl rand -hex 32
PORT=3520
HOST=127.0.0.1
PUBLIC_URL=https://geoletter.example.org
DB_PATH=data/geoletter.db

OLLAMA_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma4-local:e2b
# The server is shared: two CPU threads per Gemma call, one call at a time.
OLLAMA_NUM_THREAD=2
OLLAMA_KEEP_ALIVE=5m

GEOLETTER_SECRET=
# Visiting /?demo=1&token=<ADMIN_TOKEN> turns on demo mode for that browser (opens sealed letters).
ADMIN_TOKEN=
# DEMO_MODE=1 opens sealed letters for everyone. Leave at 0 in production.
DEMO_MODE=0

# log = print notices to the console (default). smtp = send them.
MAIL_DRIVER=log
MAIL_FROM=GeoLetter <letters@example.org>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
EMAIL_DAILY_LIMIT=3

LOCK_RADIUS_DEFAULT=200
NOMINATIM_USER_AGENT=GeoLetter/0.1 (open-source memorial map; https://geoletter.example.org)
# Place search while typing (OpenStreetMap, no key). Nominatim joins in on Enter and is the fallback.
# PHOTON_URL=https://photon.komoot.io
